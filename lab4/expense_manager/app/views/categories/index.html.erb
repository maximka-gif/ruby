<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="display-6 m-0">Категорії витрат</h1>
  <%= link_to "Нова категорія", new_category_path, class: "btn btn-success shadow-sm" %>
</div>

<div class="card shadow-sm" style="max-width: 600px;">
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>Назва категорії</th>
          <th class="text-end">Дії</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td>
              <strong><%= link_to category.name, category, class: "text-dark text-decoration-none" %></strong>
            </td>
            <td class="text-end">
              <%= link_to "Переглянути", category, class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Ред.", edit_category_path(category), class: "btn btn-sm btn-outline-warning ms-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3">
  <%= link_to "← Назад до витрат", expenses_path, class: "btn btn-link text-decoration-none p-0" %>
</div>